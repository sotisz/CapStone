    "speaking": "left",
    "left_name": "환웅",
    "left_avatar_emotional": "default",
    "right_name": null,
    "right_avatar_emotional": "default",
    "text": "그리고 정신을 잃은 사이, 그녀는 인간으로 깨어났다."
